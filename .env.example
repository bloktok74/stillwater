# Order emails are sent with Resend (https://resend.com). Copy to .env.local for local use,
# and add the same variables in your host's environment settings (e.g. Vercel → Settings → Environment Variables).
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend, e.g. "Stillwater Peptides <orders@stillwaterpeptides.com>"
ORDER_FROM_EMAIL=
# Where new-order notifications go (your inbox)
ORDER_NOTIFY_EMAIL=
